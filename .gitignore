# ── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Secrets & environment ───────────────────────────────────────
.env
.env.local
.env.*.local
# keep the template tracked
!.env.example
# Streamlit secrets (a non-secret .streamlit/config.toml can still be committed)
.streamlit/secrets.toml

# App-local state (your saved panel setup, auto-created on Save)
llm_duel_config.json

# ── Tooling / editors ───────────────────────────────────────────
# machine-local Claude Code settings (launch.json stays tracked)
.claude/settings.local.json
.vscode/
.idea/
*.swp
*.swo
node_modules/
*.log

# ── OS cruft ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ── Manual generation ───────────────────────────────────────────
# scratch from docx -> pdf preview conversions
_docx_preview.pdf
# The manual is committed by default so it's viewable on GitHub. To regenerate
# it on demand (via `python tools/make_manual.py`) instead of tracking the
# binaries, uncomment these:
# LLM_Duel_Manual.pdf
# LLM_Duel_Manual.docx
# assets/
